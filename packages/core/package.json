{
	"name": "@felinejs/core",
	"description": "Opinionated Backend framework library for Node.js on top of Fastify",
	"version": "0.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": ""
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"keywords": ["feline", "fastify", "backend", "framework", "nodejs", "typescript"],
	"scripts": {
		"build": "pkgroll --tsconfig=tsconfig.lib.json  --clean-dist --sourcemap"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"awilix": "^12.0.5",
		"axios": "^1.13.4",
		"fastify": "^5.7.2",
		"fastify-plugin": "^5.1.0",
		"fastify-type-provider-zod": "^6.1.0",
		"pino": "^10.3.0",
		"pino-pretty": "^13.1.3",
		"zod": "^4.3.6"
	},
	"files": ["dist"],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./zod": {
			"require": {
				"types": "./dist/bearers/zod.d.cts",
				"default": "./dist/bearers/zod.cjs"
			},
			"import": {
				"types": "./dist/bearers/zod.d.mts",
				"default": "./dist/bearers/zod.mjs"
			}
		},
		"./awilix": {
			"require": {
				"types": "./dist/bearers/awilix.d.cts",
				"default": "./dist/bearers/awilix.cjs"
			},
			"import": {
				"types": "./dist/bearers/awilix.d.mts",
				"default": "./dist/bearers/awilix.mjs"
			}
		},
		"./utils": {
			"require": {
				"types": "./dist/lib/utils/index.d.cts",
				"default": "./dist/lib/utils/index.cjs"
			},
			"import": {
				"types": "./dist/lib/utils/index.d.mts",
				"default": "./dist/lib/utils/index.mjs"
			}
		}
	}
}
